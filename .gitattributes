* text=auto eol=lf
# Managed testing files are hash-verified and retain their exact bytes.
**/.agents/** -text
**/.minecraft-mod-testing/** -text
**/mod-build.ps1 -text
**/mod-build.cmd -text
**/gradlew.bat -text
LICENSE* -text
**/LICENSE* -text

# Preserve the upstream generated-resource line-ending policy.
src/generated/**/.cache/cache text eol=lf
src/generated/**/*.json text eol=lf

# Bind generated build inputs and validation sources to their exact tested bytes.
src/** -text
scripts/** -text
gradle/** -text
validation/** -text
build.gradle -text
settings.gradle -text
gradle.properties -text
MODPORTER-* -text
